# ---- IA local (Ollama) ----
# Endereço base do servidor Ollama (também aceita .../api/generate)
LLM_URL=http://192.168.15.6:11434
# Modelo de texto para correção de OCR (vazio = automático, prefere ~14b)
LLM_TEXT_MODEL=
# Modelo com visão para transcrever páginas manuscritas/imagem (vazio = automático, prefere ~7b)
# Ex.: qwen2.5vl:7b, llava:7b, minicpm-v, gemma3:12b
LLM_VISION_MODEL=
LLM_TIMEOUT=300
# Tempo máximo por página na IA de visão (modelos grandes sem GPU suficiente são lentos)
LLM_VISION_TIMEOUT=1200
# Lado maior da imagem enviada (reduzido automaticamente se faltar memória na GPU)
LLM_VISION_MAX_SIDE=1400
# Páginas com saúde abaixo deste valor são enviadas ao modelo de visão (se ativado)
LLM_VISION_THRESHOLD=75
# Máximo de páginas enviadas à IA de visão por documento (0 = sem limite)
LLM_VISION_MAX_PAGES=0

# ---- Leitura / OCR ----
# OCR em todas as páginas para validação cruzada (máxima segurança). false = OCR só quando necessário
ALWAYS_OCR=true
OCR_DPI=300
OCR_MAX_DPI=600
OCR_LANG=por+eng
# Caminho do Tesseract (Windows, se não estiver no PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Processos paralelos (padrão = nº de CPUs)
# WORKERS=4

# ---- Saúde da leitura ----
HEALTH_WARN=70
HEALTH_CRITICAL=50

# ---- Saída ----
REMOVE_REPEATED_HEADERS=true
MAX_UPLOAD_MB=500
